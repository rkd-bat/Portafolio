---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SocialIcon from "./SocialIcon.astro";
import { site } from "../config/site";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const profiles = [
  { label: "LinkedIn", url: site.linkedin, icon: "linkedin" },
  { label: "GitHub", url: site.github, icon: "github" },
] as const;
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4"
  >
    <a
      href="#inicio"
      class="text-lg font-bold tracking-wide text-zinc-100"
      aria-label={t.goHome}
    >
      LB<span class="text-amber-400">.</span>
    </a>

    <nav aria-label={t.mainNavigation}>
      <ul
        class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-zinc-300"
      >
        <li>
          <a href="#proyectos" class="transition-colors hover:text-amber-400">
            {t.projects}
          </a>
        </li>
        <li>
          <a href="#sobre-mi" class="transition-colors hover:text-amber-400">
            {t.about}
          </a>
        </li>
        <li>
          <a href="#habilidades" class="transition-colors hover:text-amber-400">
            {t.skills}
          </a>
        </li>
        <li>
          <a href="#contacto" class="transition-colors hover:text-amber-400">
            {t.contact}
          </a>
        </li>
        <li>
          <ul aria-label={t.professionalProfiles} class="flex items-center gap-1">
            {profiles.map((profile) => (
              <li>
                <a
                  href={profile.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${profile.label} (${t.opensNewTab})`}
                  class="inline-flex size-11 items-center justify-center text-zinc-300 transition-colors hover:text-amber-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400"
                >
                  <SocialIcon name={profile.icon} />
                </a>
              </li>
            ))}
          </ul>
        </li>
        <li>
          <LanguageSwitcher lang={lang} />
        </li>
      </ul>
    </nav>
  </div>
</header>
