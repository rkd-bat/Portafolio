---
import ProjectGallery from "./ProjectGallery.astro";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section
  id="proyectos"
  aria-labelledby="featured-projects-title"
  class="mx-auto max-w-6xl scroll-mt-28 px-6 py-24"
>
  <div class="mb-10 border-t border-white/10 pt-8">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-amber-400">{t.selectedWork}</p>
    <h2 id="featured-projects-title" class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl">
      {t.projects}
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-400">{t.projectsIntroduction}</p>
  </div>

  <ProjectGallery lang={lang} />
</section>
