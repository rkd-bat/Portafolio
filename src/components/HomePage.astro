---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedProjects from "./FeaturedProjects.astro";
import AboutMe from "./AboutMe.astro";
import Skills from "./Skills.astro";
import Contact from "./Contact.astro";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<BaseLayout
  lang={lang}
  title="Liam Barrientos | Full Stack Developer & UI/UX Designer"
  description={t.heroDescription}
>
  <main id="inicio">
    <section
      class="mx-auto flex min-h-[85vh] max-w-6xl flex-col justify-center px-6 py-24"
    >
      <p class="text-sm uppercase tracking-[0.2em] text-amber-400">
        {t.heroRole}
      </p>
      <h1
        class="mt-6 max-w-4xl text-5xl font-semibold tracking-tight md:text-7xl"
      >
        {t.heroTitle}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-zinc-400">{t.heroDescription}</p>
      <a
        class="mt-10 w-fit rounded-full border border-amber-400 px-6 py-3 text-amber-300"
        href="#proyectos"
      >
        {t.viewProjects}
      </a>
    </section>

    <FeaturedProjects lang={lang} />

    <AboutMe lang={lang} />
    <Skills lang={lang} />

    <Contact lang={lang} />
  </main>
</BaseLayout>
